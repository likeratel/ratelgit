{
  "name": "ratelgit",
  "private": true,
  "version": "0.1.1",
  "license": "MIT",
  "description": "A Git client for moving quickly between projects and worktrees, built with Tauri 2, React, and Rust.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/likeratel/ratelgit.git"
  },
  "packageManager": "pnpm@10.30.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "desktop:build": "pnpm tauri build",
    "format": "prettier --write src tests *.ts *.json index.html",
    "format:check": "prettier --check src tests *.ts *.json index.html"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.19",
    "@tauri-apps/api": "^2",
    "lucide-react": "^1.57.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.4"
  }
}
